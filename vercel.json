{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "server/db/schema.sql"
    },
    "api/auth/*.js": {
      "includeFiles": "server/db/schema.sql"
    },
    "api/employees/[id].js": {
      "includeFiles": "server/db/schema.sql"
    },
    "api/employees/[id]/*.js": {
      "includeFiles": "server/db/schema.sql"
    },
    "api/documents/[id]/*.js": {
      "includeFiles": "server/db/schema.sql"
    }
  }
}
